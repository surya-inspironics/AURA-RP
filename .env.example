# AURA Enterprise SaaS Environment Variables

# App URL & Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api/v1

# Backend Proxy / Direct URL
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# Database Configuration (PostgreSQL / Neon in production, SQLite fallback in dev)
DATABASE_URL=postgresql://user:password@ep-sample-neon.us-east-2.aws.neon.tech/aura_db?sslmode=require

# Authentication & JWT Security
JWT_SECRET=generate_strong_random_secret_for_production_use
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Evidence Storage Configuration
# AWS S3 in production / Local directory in dev
STORAGE_DIR=backend/storage/evidence
AWS_S3_BUCKET_NAME=aura-evidence-private-production
AWS_REGION=us-east-1

# Environment
ENVIRONMENT=production
